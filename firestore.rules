rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthorizedExecutive() {
      return isSignedIn() && (
        request.auth.token.email == 'robert@unclerobertconsulting.com' ||
        request.auth.token.email == 'robert@agent-lab.tech' ||
        request.auth.token.email == 'thebossrob@gmail.com' ||
        request.auth.token.email == 'agentlab.tech@gmail.com' ||
        request.auth.token.email == 'burnssheena335@gmail.com' ||
        request.auth.token.email == 'sheena@unclerobertconsulting.com'
      );
    }

    function isValidUserProfile(data) {
      return data.email is string &&
        data.email.size() <= 128 &&
        data.role is string &&
        data.role == 'executive' &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('organization' in data) || (data.organization is string && data.organization.size() <= 128)) &&
        (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 64));
    }

    match /executive_profiles/{userId} {
      allow get: if isAuthorizedExecutive() && request.auth.uid == userId;
      allow list: if isAuthorizedExecutive() && request.auth.uid == userId;
      allow create: if isAuthorizedExecutive() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(request.resource.data);
      allow update: if isAuthorizedExecutive() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(request.resource.data);
      allow delete: if false;
    }
  }
}
